# Student Nest Environment Configuration

# Backend API URL (default: http://localhost:3000)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Firebase Auth Emulator Host for local development
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# Firebase Project ID for local development
NEXT_PUBLIC_FIREBASE_PROJECT_ID=student-nest-dev

# Firebase API Key (non-empty string required by SDK when connecting to emulator)
NEXT_PUBLIC_FIREBASE_API_KEY=any-non-empty-string-for-emulator
